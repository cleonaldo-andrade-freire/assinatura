# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública onde o app está publicado — usada pra montar links (convite de
# equipe, assinatura de documento, callback OAuth da Certisign, webhook da
# Evolution API). Em produção, o domínio final; em dev, http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave pra logar no /admin (painel interno, fora do painel de cada clínica).
ADMIN_MASTER_KEY=

# Asaas (cobrança recorrente das clínicas) — comece com a base sandbox pra testar sem dinheiro real.
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Evolution API (WhatsApp) — servidor único, global, atendendo todas as clínicas.
EVOLUTION_ADMIN_BASE_URL=
EVOLUTION_ADMIN_API_KEY=

# Assinatura digital de atestados/prescrições. Valores possíveis: "mock"
# (simula, sem validade jurídica — não exige nenhuma variável abaixo, use pra
# desenvolver sem credencial real), "certisign" (Portal de Assinaturas,
# assíncrono — dentista aprova no app dela), "psc" (Assinatura Direta em
# Nuvem / VaultID) ou "local_agent" (agente local Windows, ver app/README.md
# seção "Agente local de assinatura"). NEXT_PUBLIC_SIGNATURE_PROVIDER precisa
# repetir o mesmo valor de SIGNATURE_PROVIDER (uma é lida no servidor, a
# outra no cliente, pra decidir o texto/aviso/fluxo mostrado no formulário).
SIGNATURE_PROVIDER=mock
NEXT_PUBLIC_SIGNATURE_PROVIDER=mock
# SIGNATURE_MOCK_FORCE_FAIL=1   # opcional, só com o mock — força uma assinatura "falha" pra testar esse estado

# Certisign (ICP-Brasil A3 em nuvem) — só necessário se SIGNATURE_PROVIDER=certisign.
CERTISIGN_API_BASE_URL=
CERTISIGN_API_TOKEN=
CERTISIGN_API_CODE=
CERTISIGN_SIGNATURE_STANDARD=
CERTISIGN_WEBHOOK_SECRET=

# PSC / VaultID (assinatura em nuvem direta, login da dentista via OAuth) —
# usado pelo fluxo "Assinatura em Nuvem Direta", independente da Certisign acima.
PSC_BASE_URL=https://homologacao.vaultid.com.br
PSC_CLIENT_ID=
PSC_CLIENT_SECRET=

# Protege os endpoints de cron (GET /api/cron/...) contra chamada externa —
# a Vercel manda esse valor automaticamente no header Authorization dos crons
# configurados em vercel.json; gere uma string aleatória longa.
CRON_SECRET=
